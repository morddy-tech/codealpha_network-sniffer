# ---------------------------------------------------------------------------
# CodeAlpha Advanced Network Traffic Analyzer - environment configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Django secret key - generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to True only for local development
DEBUG=False

# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional database URL. When unset, SQLite is used (db.sqlite3 in project root).
# Examples:
#   sqlite:///db.sqlite3
#   postgres://user:password@localhost:5432/sniffer
DATABASE_URL=

# --- Packet payload privacy controls --------------------------------------
# Store limited payload previews (hex + ASCII) for captured packets?
# Strongly recommended to keep False in production.
PAYLOAD_STORAGE_ENABLED=False

# Maximum number of payload bytes stored per packet (default 256).
MAX_PAYLOAD_PREVIEW_BYTES=256

# --- Optional threat intelligence (disabled by default) -------------------
# The application works fully without any external service. When enabled,
# an administrator can perform explicit, per-IP reputation lookups.
THREAT_INTEL_ENABLED=False
THREAT_INTEL_API_KEY=

# --- Production TLS / cookie hardening (recommended when serving over HTTPS)
# Set all three to True when the site is served behind HTTPS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Logging ---------------------------------------------------------------
# Optional directory for the rotating application log. Defaults to ./logs.
LOG_DIR=

# --- Cleanup ---------------------------------------------------------------
# Default retention (days) shown in Settings / used by cleanup_packets.
DEFAULT_RETENTION_DAYS=30
